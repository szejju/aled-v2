  shadowClass: string
  level: 'none' | 'brąz' | 'srebro' | 'zloto' | 'platyna'
}

interface EpicBadge {
  icon: string
  title: string
  bgClass: string
  borderClass: string
  textClass: string
  shadowClass: string
  isEarned: boolean
  count: number
}

