          >
            {{ player.firstName }}
            <span class="text-lime">{{ player.lastName }}</span>
          </h3>

          <!-- Nick -->
          <p v-if="player.nick" class="text-xs text-muted font-bold uppercase mt-1 tracking-widest text-center">
            "{{ player.nick }}"
          </p>
          <p v-else class="text-xs text-muted">&nbsp;</p>

          <!-- Przycisk Dartcounter -->
          <div class="mt-2 flex items-center justify-center w-full relative z-20">
            <button
              v-if="player.dartcounter"
              @click.stop="showDartcounterModal(`${player.firstName} ${player.lastName}`, player.dartcounter)"
              class="bg-orange-50 text-orange-500 border border-orange-200 hover:bg-orange-500 hover:text-white px-3 py-1.5 rounded-full text-xs font-black uppercase tracking-widest transition-colors shadow-sm flex items-center gap-1"
              aria-label="Zobacz profil Dartcounter"
            >
              Dartcounter
            </button>
            <span
              v-else
              class="bg-orange-50/50 text-orange-300 border border-orange-100/50 px-3 py-1.5 rounded-full text-xs font-black uppercase tracking-widest flex items-center gap-1 cursor-not-allowed opacity-75"
              title="Gracz nie dodał jeszcze linku do Dartcounter"
              aria-label="Brak profilu Dartcounter"
            >
              Dartcounter
            </span>
          </div>

          <!-- Statystki główne -->
          <div class="grid grid-cols-2 gap-3 w-full mt-4 md:mt-5">
            <div class="bento p-3 text-center border-b-2 border-b-lime">
              <div class="text-xs font-black uppercase text-muted tracking-widest mb-1">
                Power Ranking
              </div>
              <div class="text-lg md:text-xl font-black text-fg">
                {{ player.st.dpi ? player.st.dpi.toFixed(2) : '-' }}
              </div>
            </div>
            <div class="bento p-3 text-center border-b-2 border-b-line">
              <div class="text-xs font-black uppercase text-muted tracking-widest mb-1">
                Średnia
              </div>
              <div class="text-lg md:text-xl font-black text-fg">
                {{ player.st.realAvg ? player.st.realAvg.toFixed(2) : '-' }}
              </div>
            </div>
          </div>

          <!-- Forma (ostatnie 5 meczów) -->
          <div class="mt-4 w-full">
            <div class="flex items-center justify-center gap-1.5">
              <div
                v-for="(result, index) in lastFiveForm(player.st.form)"
                :key="index"
                class="size-3 rounded-full transition-all"
                :class="formDotClass[result]"
                :title="result === 'W' ? 'Wygrana' : result === 'D' ? 'Remis' : result === 'L' ? 'Przegrana' : 'Brak meczu'"
              ></div>
            </div>
          </div>

          <!-- Separator przed Gablotą -->
          <div class="mt-6 pt-4 border-t-2 border-dashed border-line w-full">
<!-- Sekcja osiągnięć -->
            <div class="space-y-3">
              <!-- 1. TROFEA -->
              <div
                v-if="allAchievements[player.id]?.trophies?.length"
                class="bg-gradient-to-br from-amber-50/60 to-yellow-50/40 p-2 rounded-2xl border border-amber-100 flex items-center justify-center shadow-inner"
              >
                <div class="flex flex-wrap justify-center gap-1.5">
                  <div
                    v-for="(trophy, idx) in allAchievements[player.id].trophies"
                    :key="idx"
                    class="size-7 flex items-center justify-center rounded-xl border text-xs transition-transform duration-300 hover:scale-125 cursor-help"
                    :class="[
                      decodeTrophy(trophy).bgClass,
                      decodeTrophy(trophy).borderClass,
                      decodeTrophy(trophy).textClass,
                      decodeTrophy(trophy).shadowClass
                    ]"
                    :title="decodeTrophy(trophy).title"
                  >
                    {{ decodeTrophy(trophy).icon }}
                  </div>
                </div>
              </div>

              <!-- 2. KAMIENIE MILOWE -->
              <div class="flex justify-center gap-2 border-b border-line pb-2">
                <div
                  v-for="(badge, idx) in [
                    getMilestoneBadge(
                      allAchievements[player.id]?.career_stats?.matches_played || 0,
                      [10, 50, 100, 200],
                      '🛡️',
                      'Weteran Tarczy'
                    ),
                    getMilestoneBadge(
                      allAchievements[player.id]?.career_stats?.matches_won || 0,
                      [5, 25, 75, 150],
                      '⚔️',
                      'Kolekcjoner Skalpów'
                    ),
                    getMilestoneBadge(
                      allAchievements[player.id]?.career_stats?.seasons_count || 1,
                      [2, 5, 10, 20],
                      '🌱',
                      'Sezonowiec'
                    ),
                    getMilestoneBadge(
                      allAchievements[player.id]?.career_stats?.total_180s || 0,
                      [5, 25, 100, 180],
                      '🔥',
                      'Klub 180s'
                    ),
                    getMilestoneBadge(
                      allAchievements[player.id]?.career_stats?.total_100_checkouts || 0,
                      [5, 20, 50, 100],
                      '🎯',
                      'Finish 100+'
                    ),
                  ]"
                  :key="idx"
                  class="size-7 flex items-center justify-center rounded-full border-2 text-xs transition-transform duration-300 hover:scale-110 cursor-help"
                  :class="[badge.bgClass, badge.borderClass, badge.textClass, badge.shadowClass]"
                  :title="`${badge.title} [${badge.level.toUpperCase()}]: ${allAchievements[player.id]?.career_stats?.[idx === 0 ? 'matches_played' : idx === 1 ? 'matches_won' : idx === 2 ? 'seasons_count' : idx === 3 ? 'total_180s' : 'total_100_checkouts'] || 0}`"
                >
                  {{ badge.icon }}
                </div>
              </div>

              <!-- 3. EPICKIE MOMENTY -->
              <div class="flex justify-center gap-2">
                <div
                  v-for="(badge, idx) in [
                    getEpicBadge(
                      allAchievements[player.id]?.epic_moments?.nine_darter || 0,
                      '👑',
                      '9-Darter',
                      'bg-cyan-100 border-cyan-400 text-cyan-600'
                    ),
                    getEpicBadge(
                      allAchievements[player.id]?.epic_moments?.big_fish || 0,
                      '🦈',
                      'Big Fish',
                      'bg-yellow-100 border-yellow-400 text-yellow-600'
                    ),
                    getEpicBadge(
                      allAchievements[player.id]?.epic_moments?.small_fish || 0,
                      '🐟',
                      'Small Fish',
                      'bg-slate-100 border-slate-400 text-slate-600'
                    ),
                    getEpicBadge(
                      allAchievements[player.id]?.epic_moments?.whitewash || 0,
                      '🧹',
                      'Whitewash',
                      'bg-orange-100 border-orange-400 text-orange-600'
                    ),
                  ]"
                  :key="idx"
                  class="size-7 flex items-center justify-center rounded-lg border text-xs relative transition-all duration-300 hover:scale-110 cursor-help"
                  :class="[badge.bgClass, badge.borderClass, badge.textClass, badge.shadowClass]"
                  :title="badge.title"
                >
                  {{ badge.icon }}
                  <!-- Licznik dla wielokrotnych wyczynów -->
                  <span
                    v-if="badge.count > 1"
                    class="absolute -top-1.5 -right-1.5 bg-danger text-white text-[10px] font-black rounded-full size-3.5 flex items-center justify-center shadow-sm"
                  >
                    {{ badge.count }}
                  </span>
                </div>
              </div>
            </div>
          </div>
        </article>
      </div>
    </main>

    <!-- Modal profilu zawodnika -->
    <PlayerCardModal
      :player="selectedPlayer as any"
      @close="selectedPlayer = null"
    />
  </div>
</template>
            <!-- Nagłówek Gablota Osiągnięć -->
            <div class="text-center mb-4">
              <span class="text-sm font-black uppercase tracking-[0.2em] text-fg bg-gradient-to-r from-gray-700 via-gray-900 to-gray-700 bg-clip-text text-transparent">
                Gablota Osiągnięć
              </span>
            </div>
          </button>
        </nav>
      </div>

      <!-- Komunikat gdy brak graczy -->
      <div v-if="divisionPlayers.length === 0" class="col-span-full text-center py-20 text-muted font-bold uppercase">
        Brak zawodników w tej dywizji
      </div>

      <!-- Siatka zawodników -->
      <div v-else class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        <!-- Karta zawodnika -->
        <article
          v-for="player in divisionPlayers"
          :key="player.id"
          class="bg-surface border border-line rounded-2xl p-4 md:p-6 transition-all hover:border-lime-600 hover:bg-surface-2/80 group overflow-hidden relative"
        >
          <!-- Avatar -->
          <div
            class="size-24 md:size-28 rounded-full border-4 border-surface shadow-[0_0_20px_rgba(132,204,22,0.4)] overflow-hidden bg-surface-2 flex items-center justify-center mb-4 relative z-10 cursor-pointer hover:scale-105 transition-transform duration-300 mx-auto"
            @click="showPlayerModal(player)"
            :aria-label="`Otwórz profil zawodnika ${player.firstName} ${player.lastName}`"
          >
            <div
              v-if="!(player.avatarUrl || player.photoUrl)"
              class="w-full h-full flex items-center justify-center text-muted text-2xl font-black"
            >
              {{ (player.firstName?.[0] || '') + (player.lastName?.[0] || '') }}
            </div>
            <img
              v-else
              :src="player.avatarUrl || player.photoUrl"
              :alt="`${player.firstName} ${player.lastName}`"
              class="w-full h-full object-cover"
            />
          </div>
  if (!isEarned) {
    bgClass = 'bg-surface-2'
    borderClass = 'border-line'
    textClass = 'text-muted'
    shadowClass = 'shadow-inner'
  }

  return { icon, title, bgClass, borderClass, textClass, shadowClass, isEarned, count }
}
  icon: string
  title: string
  bgClass: string
  borderClass: string
  textClass: string
  shadowClass: string
  isEarned: boolean
  count: number
}

interface DivisionTab {
  id: string
  label: string
}