/* ------------------------------------------------------------------ *
 *  Stan + silnik widoku (dawniej `window.zawodnicyState` / `initZawodnicy`)
 * ------------------------------------------------------------------ */

/** Dawne `window.zawodnicyState.div`. */
const activeDiv = ref(divisions[0]?.id ?? '')

/** Zakładka kliknięta przez użytkownika – dawne `setZawodnicyFilter(divName)`. */
const setActiveDivision = (divId: string) => {
  activeDiv.value = divId
}

/** Gracze w aktywnej dywizji – z filtrowaniem */
const divisionPlayers = computed(() =>
  roster.filter((p) => p.div.trim().toUpperCase() === activeDiv.value)
)

/* ------------------------------------------------------------------ *
 *  Helpery do dekodowania gabloty
 * ------------------------------------------------------------------ */

/**
 * Dawne `decodeTrophy` → zwraca obiekt zamiast HTML.
 */
function decodeTrophy(trophyKey: string): TrophyBadge {
  const parts = trophyKey.split('_')
  const seasonTag = parts[0] ? `Sezon ${parts[0].replace('s', '')}` : ''
  
  let icon = "🏆"
  let title = "Trofeum Ligi"
  let bgClass = "bg-yellow-50"
  let borderClass = "border-yellow-400"
  let textClass = "text-yellow-600"
  let shadowClass = "shadow-md"

  if (trophyKey.includes('champ') || trophyKey.endsWith('_1')) {
    icon = "🥇"
    title = `Mistrz Dywizji (${seasonTag})`
    bgClass = "bg-amber-100"
    borderClass = "border-amber-500"
    textClass = "text-amber-700"
    shadowClass = "shadow-md"
  } else if (trophyKey.includes('vice') || trophyKey.endsWith('_2')) {
    icon = "🥈"
    title = `Wicemistrz Dywizji (${seasonTag})`
    bgClass = "bg-slate-100"
    borderClass = "border-slate-400"
    textClass = "text-slate-600"
    shadowClass = "shadow-sm"
  } else if (trophyKey.includes('bronze') || trophyKey.endsWith('_3')) {
    icon = "🥉"
    title = `Brązowy Medalista Dywizji (${seasonTag})`
    bgClass = "bg-orange-100"
    borderClass = "border-orange-400"
    textClass = "text-orange-700"
    shadowClass = "shadow-sm"
  } else if (trophyKey.includes('cup_winner')) {
    icon = "🏆"
    title = `Zdobywca Pucharu Ligi (${seasonTag})`
    bgClass = "bg-gradient-to-br from-yellow-400 to-amber-500"
    borderClass = "border-amber-600"
    textClass = "text-white"
    shadowClass = "shadow-lg"
  }
  // Puchary Imienne (Rekordziści)
  else if (trophyKey.includes('littler')) {
    icon = "👶"
    title = `Puchar Luke'a Littlera (${seasonTag}) - Najwięcej Maksów`
    bgClass = "bg-purple-100"
    borderClass = "border-purple-400"
    textClass = "text-purple-600"
    shadowClass = "shadow-sm"
  } else if (trophyKey.includes('humphries')) {
    icon = "🎯"
    title = `Puchar Luke'a Humphriesa (${seasonTag}) - Najwyższy Check-Out`
    bgClass = "bg-blue-100"
    borderClass = "border-blue-400"
    textClass = "text-blue-600"
    shadowClass = "shadow-sm"
  } else if (trophyKey.includes('smith')) {
    icon = "⚡"
    title = `Puchar Michaela Smitha (${seasonTag}) - Najszybszy Leg`
    bgClass = "bg-red-100"
    borderClass = "border-red-400"
    textClass = "text-red-600"
    shadowClass = "shadow-sm"
  } else if (trophyKey.includes('mvg')) {
    icon = "🟢"
    title = `Puchar Michaela van Gerwena (${seasonTag}) - Najwyższy Power Ranking`
    bgClass = "bg-lime-100"
    borderClass = "border-lime-400"
    textClass = "text-lime-600"
    shadowClass = "shadow-sm"
  } else if (trophyKey.includes('taylor')) {
    icon = "👑"
    title = `Puchar Phila Taylora (${seasonTag}) - Najwyższa Średnia Sezonu`
    bgClass = "bg-yellow-100"
    borderClass = "border-yellow-500"
    textClass = "text-yellow-700"
    shadowClass = "shadow-md"
  }

  return { icon, title, bgClass, borderClass, textClass, shadowClass }
}

/**
 * Dawne `getMilestoneBadge` → zwraca obiekt zamiast HTML.
 */
function getMilestoneBadge(
  val: number,
  thresholds: [number, number, number, number],
  icon: string,
  title: string
): MilestoneBadge {
  let level: 'none' | 'brąz' | 'srebro' | 'zloto' | 'platyna' = 'none'
  if (val >= thresholds[3]) level = 'platyna'
  else if (val >= thresholds[2]) level = 'zloto'
  else if (val >= thresholds[1]) level = 'srebro'
  else if (val >= thresholds[0]) level = 'brąz'

  let bgClass = 'bg-surface-2'
  let borderClass = 'border-line'
  let textClass = 'text-muted'
  let shadowClass = 'shadow-inner'

  if (level === 'brąz') {
    bgClass = 'bg-orange-50'
    borderClass = 'border-orange-300'
    textClass = 'text-orange-800'
    shadowClass = 'shadow-sm'
  } else if (level === 'srebro') {
    bgClass = 'bg-slate-50'
    borderClass = 'border-slate-300'
    textClass = 'text-slate-700'
    shadowClass = 'shadow-sm'
  } else if (level === 'zloto') {
    bgClass = 'bg-yellow-50'
    borderClass = 'border-yellow-400'
    textClass = 'text-yellow-600'
    shadowClass = 'shadow-md'
  } else if (level === 'platyna') {
    bgClass = 'bg-cyan-50'
    borderClass = 'border-cyan-400 border-dashed'
    textClass = 'text-cyan-600'
    shadowClass = 'shadow-[0_0_10px_rgba(34,211,238,0.5)]'
  }

  return { icon, title, bgClass, borderClass, textClass, shadowClass, level }
}

/**
 * Dawne `getEpicBadge` → zwraca obiekt zamiast HTML.
 */
function getEpicBadge(
  count: number,
  icon: string,
  title: string,
  bgActive: string
): EpicBadge {
  const isEarned = count > 0
  let bgClass = bgActive
  let borderClass = isEarned ? 'border-lime-400' : 'border-line'
  let textClass = isEarned ? 'text-fg' : 'text-muted'
  let shadowClass = isEarned ? 'shadow-sm' : 'shadow-inner'

  if (!isEarned) {
    bgClass = 'bg-surface-2'
    borderClass = 'border-line'
    textClass = 'text-muted'
    shadowClass = 'shadow-inner'
  }

  return { icon, title, bgClass, borderClass, textClass, shadowClass, isEarned, count }
}

/**
 * Generuje ostatnie 5 wyników z dopełnieniem do pełnych 5 kropek.
 */
const lastFiveForm = (form: FormResult[]): FormResult[] => {
  const dots = form.slice(-5)
  while (dots.length < 5) dots.unshift('N')
  return dots
}

const formDotClass: Record<FormResult, string> = {
  W: 'bg-lime text-on-lime shadow-sm border border-lime-600',
  D: 'bg-yellow-400 text-on-yellow-400 shadow-sm border border-yellow-500',
  L: 'bg-danger text-white shadow-sm border border-red-600',
  N: 'bg-surface-2 shadow-inner border border-line',
}

const formDotText: Record<FormResult, string> = {
  W: 'W',
  D: 'R',
  L: 'P',
  N: '-',
}

/* ------------------------------------------------------------------ *
 *  Stan aplikacji
 * ------------------------------------------------------------------ */

const selectedPlayer = ref<RawPlayer | null>(null)

const showPlayerModal = (player: RawPlayer) => {
  selectedPlayer.value = player
}

const activeDiv = ref(divisions[0]?.id ?? '')

/** Zakładka kliknięta przez użytkownika – dawne `setZawodnicyFilter(divName)`. */
const setActiveDivision = (divId: string) => {
  activeDiv.value = divId
}

/** Gracze w aktywnej dywizji – z filtrowaniem */
const divisionPlayers = computed(() =>
  roster.filter((p) => p.div.trim().toUpperCase() === activeDiv.value)
)
</script>

