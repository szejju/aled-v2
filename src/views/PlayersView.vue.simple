<script setup lang="ts">
import { computed, ref } from 'vue'
import PlayerCardModal from '@/components/player/PlayerCardModal.vue'

/* ------------------------------------------------------------------ *
 *  Modele danych dla osiągnięć
 * ------------------------------------------------------------------ */

type FormResult = 'W' | 'D' | 'L' | 'N'

interface PlayerStats {
  m: number
  w: number
  d: number
  l: number
  lw: number
  ll: number
  realAvg: number
  pts: number
  form: FormResult[]
  dpi?: number
  doublesPct?: number
}

interface RawPlayer {
  id: string
  div: string
  group?: string
  firstName: string
  lastName: string
  nick?: string
  avatarUrl?: string
  photoUrl?: string
  isDisqualified?: boolean
  st: PlayerStats
  checkout?: number
  short?: number
  max?: number
  dartcounter?: string
  history?: any[]
}

interface AchievementData {
  trophies: string[]
  career_stats: {
    matches_played?: number
    matches_won?: number
    seasons_count?: number
    total_180s?: number
    total_100_checkouts?: number
  }
  epic_moments: {
    nine_darter?: number
    big_fish?: number
    small_fish?: number
    whitewash?: number
  }
}

interface MilestoneBadge {
  icon: string
  title: string
  bgClass: string
  borderClass: string
  textClass: string
  shadowClass: string
  level: 'none' | 'brąz' | 'srebro' | 'zloto' | 'platyna'
}

interface EpicBadge {
  icon: string
  title: string
  bgClass: string
  borderClass: string
  textClass: string
  shadowClass: string
  isEarned: boolean
  count: number
}

interface DivisionTab {
  id: string
  label: string
}

interface TrophyBadge {
  icon: string
  title: string
  bgClass: string
  borderClass: string
  textClass: string
  shadowClass: string
}
</script>

<template>
  <div class="min-h-screen bg-ink text-fg">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:py-12">
      <header class="mb-10">
        <div class="flex flex-col items-start justify-between gap-4 lg:flex-row lg:items-center">
          <div>
            <h1 class="font-display text-4xl font-black uppercase tracking-tight lg:text-5xl">
              Zawodnicy <span class="text-accent">ligi</span>
            </h1>
            <p class="mt-2 max-w-2xl text-base text-muted">
              Karty graczy z&nbsp;gablotą osiągnięć, statystykami ligowymi i&nbsp;panlem Dartcounter
            </p>
          </div>
          <div class="text-sm text-muted font-medium">
            Razem: <span class="ml-1 font-display text-xl font-extrabold tabular-nums text-fg">{{ players.length }}</span>
            <span class="ml-2 font-normal">zawodników</span>
          </div>
        </div>
      </header>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <article
          v-for="player in players"
          :key="player.id"
          class="bg-surface border border-line rounded-2xl p-6 transition-all hover:border-lime-600 hover:bg-surface-2/80"
        >
          <h3 class="text-xl font-black uppercase text-fg mb-2">
            {{ player.firstName }} <span class="text-lime">{{ player.lastName }}</span>
          </h3>
          
          <p v-if="player.nick" class="text-sm text-muted italic mb-4">
            "{{ player.nick }}"
          </p>
          
          <div class="grid grid-cols-2 gap-4">
            <div class="text-center">
              <div class="text-xs text-muted uppercase mb-1">Mecze</div>
              <div class="font-display text-2xl font-black tabular-nums text-fg">
                {{ player.stats.m }}
              </div>
            </div>
            <div class="text-center">
              <div class="text-xs text-muted uppercase mb-1">Punkty</div>
              <div class="font-display text-2xl font-black tabular-nums text-accent">
                {{ player.stats.pts }}
              </div>
            </div>
          </div>

          <button
            @click="showPlayerModal(player)"
            class="mt-6 w-full rounded-lg bg-lime hover:bg-lime-soft text-on-lime font-bold uppercase text-sm py-2.5 px-4 transition-colors"
          >
            Otwórz profil
          </button>
        </article>
      </div>
    </div>

    <PlayerCardModal
      :player="selectedPlayer as any"
      @close="selectedPlayer = null"
    />
  </div>
</template>